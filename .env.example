# AI Engines: Groq & Gemini Configuration
# GROQ_API_KEY: High-speed LLM inference for lead scoring, intent extraction & follow-up drafting
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# GEMINI_API_KEY: Injected automatically by AI Studio from secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_MODEL="gemini-3.8-flash"

# Application URL & Deployment Config
APP_URL="MY_APP_URL"
PORT="3000"
# Optional: Set VITE_API_BASE_URL if backend is hosted on a separate domain (e.g. Render, Railway, Cloud Run).
# If deploying as a unified app on Vercel or running locally, leave this empty to use relative /api routes.
VITE_API_BASE_URL=""

# Authentication & Security
JWT_SECRET="your-super-secure-jwt-secret-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"

# Database Configuration (PostgreSQL / Relational Storage)
DATABASE_URL="postgresql://elevator_admin:secure_pass@localhost:5432/elevator_crm_db"

# Transactional Email (Resend)
RESEND_API_KEY="re_123456789_abcdefg"
EMAIL_FROM="sales@elevatorcrm.io"

# Official WhatsApp Cloud / Business API
WHATSAPP_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="109876543210"
WHATSAPP_VERIFY_TOKEN="elevator_crm_webhook_verify_token_2026"

# n8n Automation Engine Webhooks (Direct webhook URL without requiring n8n API key)
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/elevator-lead-automation"
